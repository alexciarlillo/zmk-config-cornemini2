if SHIELD_CORNE_DONGLE

# Max 16 characters. config/corne.conf also sets this and takes precedence.
config ZMK_KEYBOARD_NAME
    default "CorneMini"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both halves connect to the dongle as peripherals
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 BT host profiles
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
