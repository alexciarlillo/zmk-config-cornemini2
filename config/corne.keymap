#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Bindings use the 42-key Corne layout. The outer column on each side does
// not exist on the 36-key Corne Mini, so those slots are always &trans.

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        jk-esc {
            bindings = <&kp ESC>;
            key-positions = <19 20>;
        };
    };

    macros {
        gif: gif {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    behaviors {
        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 18 30 31 7 19 8 20 32 9 21 33 10 22 34 39 40 41 38 37 36 16 15 14 13>;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <160>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <19 20 21 22 38 37 36 16 15 14 13 1 2 3 4 5 17 26 27 28 29 25 41 40 39>;
        };

        hrm_rshift: hrm_rshift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 30 31 7 19 8 20 32 9 21 33 10 22 34 39 40 41 38 37 36 16 15 14 13 5 29 17 28 4 3 27 2 26 1 25>;
        };

        lt_qt: lt_qt {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 18 30 31 7 19 8 20 32 9 21 33 10 22 34 39 40 41 38 37 36 16 15 14 13 5 29 17 28 4 3 27 2 26 1 25>;
        };

        hrm_lshift: hrm_lshift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 30 31 7 19 8 20 32 9 21 33 10 22 34 39 40 41 38 37 36 16 15 13 5 29 17 28 4 3 27 2 26 1 25 14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&trans  &kp Q                 &kp W             &kp E             &kp R              &kp T           &kp Y               &kp U               &kp I              &kp O              &kp P                    &trans
&trans  &hrm_lshift LSHIFT A  &hrm_left LGUI S  &hrm_left LALT D  &hrm_left LCTRL F  &kp G           &kp H               &hrm_right RCTRL J  &hrm_right RALT K  &hrm_right RGUI L  &hrm_rshift RSHIFT SEMI  &trans
&trans  &kp Z                 &kp X             &kp C             &kp V              &kp B           &kp N               &kp M               &kp COMMA          &kp DOT            &kp SLASH                &trans
                                                &mo 1             &kp SPACE          &lt_qt 2 DEL    &lt_qt 1 BACKSPACE  &kp RETURN          &mo 2
            >;
        };

        num_sym {
            display-name = "NumSym";
            bindings = <
&trans  &trans     &kp LEFT_BRACKET  &kp SINGLE_QUOTE   &kp RIGHT_BRACKET      &kp KP_MINUS     &kp KP_PLUS       &kp N7        &kp N8        &kp N9        &kp KP_NUMBER_0  &trans
&trans  &kp TILDE  &kp LPAR          &kp GRAVE          &kp RIGHT_PARENTHESIS  &kp UNDER        &kp EQUAL         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans     &kp LBRC          &kp DOUBLE_QUOTES  &kp RIGHT_BRACE        &kp LESS_THAN    &kp GREATER_THAN  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_NUMBER_0  &trans
                                     &kp LSHIFT         &trans                 &trans           &trans            &trans        &kp RSHFT
            >;
        };

        nav_sym {
            display-name = "NavSym";
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH   &kp DLLR     &kp PRCNT    &kp CARET  &kp AMPS       &kp ASTERISK  &kp BACKSLASH  &trans  &trans
&trans  &trans    &trans  &trans     &kp TAB      &trans       &kp LEFT   &kp DOWN       &kp UP_ARROW  &kp RIGHT      &trans  &trans
&trans  &trans    &trans  &trans     &kp LS(TAB)  &trans       &kp HOME   &kp PAGE_DOWN  &kp PG_UP     &kp END        &trans  &trans
                          &kp LSHFT  &trans       &trans       &kp DEL    &trans         &kp RSHFT
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&trans  &sys_reset    &studio_unlock        &out OUT_TOG              &trans          &trans          &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &bootloader   &kp RS(RG(NUMBER_4))  &kp RS(RC(RG(NUMBER_4)))  &kp RS(RG(N5))  &trans          &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2              &bt BT_SEL 3    &bt BT_CLR_ALL  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                            &trans                    &trans          &trans          &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
